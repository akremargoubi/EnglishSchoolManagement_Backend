pipeline {
    agent any

    environment {
        SERVICE_NAME = 'esmauthms'
        SERVICE_DIR  = 'esmauthms'
        DOCKER_IMAGE = "akremargoubi/esmauthms"
        DOCKER_TAG   = "${BUILD_NUMBER}"
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Install Dependencies') {
            steps {
                dir("${SERVICE_DIR}") {
                    sh 'chmod +x mvnw && ./mvnw dependency:resolve -B -q'
                }
            }
        }

        stage('Run Tests') {
            steps {
                dir("${SERVICE_DIR}") {
                    sh './mvnw test -B'
                }
            }
            post {
                always {
                    junit allowEmptyResults: true,
                          testResults: "${SERVICE_DIR}/target/surefire-reports/*.xml"
                }
            }
        }

        stage('SonarQube Analysis') {
            steps {
                dir("${SERVICE_DIR}") {
                    withSonarQubeEnv('SonarQube') {
                        sh './mvnw sonar:sonar -B'
                    }
                }
            }
        }

        stage('Quality Gate') {
            steps {
                timeout(time: 3, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        stage('Docker Build') {
            steps {
                dir("${SERVICE_DIR}") {
                    sh "docker build -t ${DOCKER_IMAGE}:${DOCKER_TAG} -t ${DOCKER_IMAGE}:latest ."
                }
            }
        }

        stage('Docker Push') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'dockerhub-credentials',
                    usernameVariable: 'DOCKER_USER',
                    passwordVariable: 'DOCKER_PASS'
                )]) {
                    sh 'echo "$DOCKER_PASS" | docker login -u "$DOCKER_USER" --password-stdin'
                    sh "docker push ${DOCKER_IMAGE}:${DOCKER_TAG}"
                    sh "docker push ${DOCKER_IMAGE}:latest"
                }
            }
        }

        stage('Deploy to K8s') {
            steps {
                sh """
                    WORKSPACE_HOST=\$(echo \$WORKSPACE | sed 's|/var/jenkins_home|/var/lib/docker/volumes/jenkins_home/_data|')
                    docker run --rm \
                      --network host \
                      -v /var/lib/docker/volumes/jenkins_home/_data/.kube:/root/.kube:ro \
                      -v \${WORKSPACE_HOST}:/workspace:ro \
                      bitnami/kubectl:1.29 \
                      apply -f /workspace/k8s/${SERVICE_DIR}/
                    docker run --rm \
                      --network host \
                      -v /var/lib/docker/volumes/jenkins_home/_data/.kube:/root/.kube:ro \
                      bitnami/kubectl:1.29 \
                      rollout restart deployment/${SERVICE_DIR} -n esm
                """
            }
        }
    }

    post {
        always {
            sh 'docker logout || true'
        }
        success {
            echo "Pipeline SUCCESS — ${DOCKER_IMAGE}:${DOCKER_TAG} pushed."
        }
        failure {
            echo "Pipeline FAILED on branch ${env.BRANCH_NAME}, build #${BUILD_NUMBER}."
        }
    }
}
