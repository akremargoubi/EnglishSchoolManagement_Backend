pipeline {
    agent any

    environment {
        IMAGE_NAME = "englishschoolmanagement_backend-assessment-service"
        NAMESPACE = "esm"
    }

    stages {
        stage('Checkout') {
            steps { checkout scm }
        }
        stage('Tests') {
            steps {
                dir('assessment-service') {
                    sh './mvnw test'
                }
            }
        }
        stage('Build Docker') {
            steps {
                dir('assessment-service') {
                    sh "docker build -t ${IMAGE_NAME}:latest -f docker/Dockerfile ."
                }
            }
        }
    stage('Deploy K8s') {
    steps {
        sh 'kubectl --kubeconfig=/var/jenkins_home/kubeconfig.yaml set image deployment/assessment-service assessment-service=englishschoolmanagement_backend-assessment-service:latest -n esm'
        sh 'kubectl --kubeconfig=/var/jenkins_home/kubeconfig.yaml rollout status deployment/assessment-service -n esm'
    }
}
    post {
        success { echo '✅ assessment-service pipeline réussi !' }
        failure { echo '❌ Échec du pipeline' }
    }
}
