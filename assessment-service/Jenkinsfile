pipeline {
    agent any
    environment {
        IMAGE_NAME = "englishschoolmanagement_backend-assessment-service"
        NAMESPACE = "esm"
        CA_B64 = ""
        CERT_B64 = ""
        KEY_B64 = ""
    }
    stages {
        stage('Checkout') {
            steps { checkout scm }
        }
        stage('Tests') {
            steps {
                dir('assessment-service') {
                    sh './mvnw test'
                }
            }
        }
        stage('Build Docker') {
            steps {
                dir('assessment-service') {
                    sh "docker build -t ${IMAGE_NAME}:latest -f docker/Dockerfile ."
                }
            }
        }
        stage('Deploy K8s') {
            steps {
                sh """
                    echo \$CA_B64 | base64 -d > /tmp/ca.crt
                    echo \$CERT_B64 | base64 -d > /tmp/client.crt
                    echo \$KEY_B64 | base64 -d > /tmp/client.key
                    kubectl set image deployment/assessment-service assessment-service=${IMAGE_NAME}:latest -n esm --server=https://192.168.49.2:8443 --certificate-authority=/tmp/ca.crt --client-certificate=/tmp/client.crt --client-key=/tmp/client.key
                """
            }
        }
    }
    post {
        success { echo 'assessment-service pipeline reussi !' }
        failure { echo 'Echec du pipeline' }
    }
}