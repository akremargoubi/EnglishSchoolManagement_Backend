pipeline {
    agent any

    environment {
        IMAGE_NAME = "englishschoolmanagement_backend-assessment-service"
        NAMESPACE = "esm"
    }

    stages {
        stage('Checkout') {
            steps { checkout scm }
        }
        stage('Tests') {
            steps {
                dir('assessment-service') {
                    sh './mvnw test'
                }
            }
        }
        stage('Build Docker') {
            steps {
                dir('assessment-service') {
                    sh "docker build -t ${IMAGE_NAME}:latest -f docker/Dockerfile ."
                }
            }
        }
        stage('Deploy K8s') {
            steps {
                sh "minikube image load ${IMAGE_NAME}:latest"
                sh "kubectl rollout restart deployment/assessment-service -n ${NAMESPACE}"
            }
        }
    }
    post {
        success { echo '✅ assessment-service déployé !' }
        failure { echo '❌ Échec du pipeline' }
    }
}