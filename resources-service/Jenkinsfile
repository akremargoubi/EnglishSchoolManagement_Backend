pipeline {
    agent any
    environment {
        IMAGE_NAME = "englishschoolmanagement_backend-resources-service"
        NAMESPACE = "esm"
    }
    stages {
        stage('Checkout') {
            steps { checkout scm }
        }
        stage('Tests') {
            steps {
                echo 'Tests skipped'
            }
        }
        stage('Build Docker') {
            steps {
                dir('resources-service') {
                    sh "docker build -t ${IMAGE_NAME}:latest -f Dockerfile ."
                }
            }
        }
        stage('Deploy K8s') {
            steps {
                sh 'kubectl --kubeconfig=/var/jenkins_home/kubeconfig.yaml set image deployment/resources-service resources-service=\:latest -n esm && kubectl --kubeconfig=/var/jenkins_home/kubeconfig.yaml rollout status deployment/resources-service -n esm'
            }
        }
    }
    post {
        success { echo 'resources-service OK' }
        failure { echo 'Echec' }
    }
}
