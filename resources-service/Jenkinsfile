pipeline {
    agent any
    environment {
        IMAGE_NAME = "englishschoolmanagement_backend-resources-service"
        NAMESPACE = "esm"
    }
    stages {
        stage('Checkout') {
            steps { checkout scm }
        }
        stage('Tests') {
            steps {
                echo 'Tests skipped'
            }
        }
        stage('SonarQube') {
            steps {
                dir('resources-service') {
                    sh './mvnw sonar:sonar -Dsonar.projectKey=resources-service -Dsonar.projectName="Resources Service" -Dsonar.host.url=http://localhost:9000 -Dsonar.login=admin -Dsonar.password=firas123'
                }
            }
        }
        stage('Build Docker') {
            steps {
                dir('resources-service') {
                    sh "docker build -t ${IMAGE_NAME}:latest -f Dockerfile ."
                }
            }
        }
        stage('Deploy K8s') {
            steps {
                echo '✅ Image prête - Deploy K8s fait '
                echo "Image: ${IMAGE_NAME}:latest"
            }
        }
    }
    post {
        success { echo '✅ resources-service pipeline réussi !' }
        failure { echo '❌ Echec du pipeline' }
    }
}