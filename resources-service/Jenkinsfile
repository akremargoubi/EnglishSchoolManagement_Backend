pipeline {
    agent any
    environment {
        IMAGE_NAME = "englishschoolmanagement_backend-resources-service"
        NAMESPACE = "esm"
    }
    stages {
        stage('Checkout') {
            steps { checkout scm }
        }
        stage('Tests') {
            steps {
                echo 'Tests skipped'
            }
        }
        stage('Build Docker') {
            steps {
                dir('resources-service') {
                    sh "docker build -t ${IMAGE_NAME}:latest -f Dockerfile ."
                }
            }
        }
        stage('Deploy K8s') {
            steps {
                echo 'Deploy K8s manuel'
            }
        }
    }
    post {
        success { echo 'resources-service OK' }
        failure { echo 'Echec' }
    }
}